# ============================================================================
# ~/.bashrc - Bash Configuration File
# ============================================================================
# Personal bashrc configuration for Gos
# Organized by concern for better maintainability

# ============================================================================
# 1. BASIC SHELL SETUP
# ============================================================================

# Add ~/.local/bin to PATH if it exists
if [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Enable the subsequent settings only in interactive sessions
case $- in
    *i*) ;;
    *) return;;
esac

# ============================================================================
# 2. OH-MY-BASH CONFIGURATION
# ============================================================================

# Path to your oh-my-bash installation
export OSH='/home/Gos/.oh-my-bash'

# Theme configuration
# OSH_THEME="atomicBit"  # Uncomment to set default theme

# Random theme configuration (if using random theme)
# OMB_THEME_RANDOM_IGNORED=("powerbash10k" "wanelo")
# OMB_THEME_RANDOM_CANDIDATES=("font" "powerline-light" "minimal")

# Oh-My-Bash behavior settings
OMB_USE_SUDO=true
# OMB_CASE_SENSITIVE="true"
# OMB_HYPHEN_SENSITIVE="false"
# DISABLE_AUTO_UPDATE="true"
# export UPDATE_OSH_DAYS=13
# DISABLE_LS_COLORS="true"
# DISABLE_AUTO_TITLE="true"
# ENABLE_CORRECTION="true"
# COMPLETION_WAITING_DOTS="true"
# DISABLE_UNTRACKED_FILES_DIRTY="true"
# SCM_GIT_DISABLE_UNTRACKED_DIRTY="true"
# SCM_GIT_IGNORE_UNTRACKED="true"
# HIST_STAMPS='yyyy-mm-dd'
# OMB_DEFAULT_ALIASES="check"
# OSH_CUSTOM=/path/to/new-custom-folder
# OMB_TERM_USE_TPUT=no

# Python and Spack environment display
# OMB_PROMPT_SHOW_PYTHON_VENV=true
# OMB_PROMPT_SHOW_SPACK_ENV=true

# Completions configuration
completions=(
    git
    composer
    ssh
)

# Aliases configuration
aliases=(
    general
)

# Plugins configuration
plugins=(
    git
    bashmarks
)

# Conditional plugins example:
# if [ "$DISPLAY" ] || [ "$SSH" ]; then
#     plugins+=(tmux-autoattach)
# fi

# Load Oh-My-Bash
source "$OSH"/oh-my-bash.sh

# ============================================================================
# 3. ENVIRONMENT VARIABLES & PATH CONFIGURATION
# ============================================================================

# Editor configuration
export EDITOR=/usr/bin/nvim

# Language and locale
# export LANG=en_US.UTF-8
# export MANPATH="/usr/local/man:$MANPATH"

# Compilation flags
# export ARCHFLAGS="-arch x86_64"

# SSH configuration
# export SSH_KEY_PATH="~/.ssh/rsa_id"

# CUDA configuration
export PATH=/usr/local/cuda-12.8/bin:$PATH
export LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

# LibTorch configuration
export LIBTORCH=/home/Gos/opt/libtorch
export LD_LIBRARY_PATH=$LIBTORCH/lib:$LD_LIBRARY_PATH

# Claude configuration
export CCLSP_CONFIG_PATH="/home/Gos/.claude/cclsp.json"

# LLM API Keys - Load from secure .env file
if [ -f "$HOME/.env" ]; then
    set -a  # Automatically export all variables
    source "$HOME/.env"
    set +a  # Disable automatic export
fi

# Android SDK configuration (commented out)
# export ANDROID_SDK_ROOT=~/Android/Sdk
# export PATH=$PATH:$ANDROID_SDK_ROOT/platform-tools

# ============================================================================
# 4. ALIASES & FUNCTIONS
# ============================================================================

# File management aliases
alias lis='yazi'  # Yazelix workspace
alias gas='z'                  # Quick directory navigation
alias dir='eza -lihG --color=auto --icons --time-style=long-iso --git --group-directories-first'
alias dirs='dust -d 1 -r'     # Directory size analysis
# alias dir='eza -lha --color=auto --icons --time-style=long-iso --git --total-size --group-directories-first'  # Alternative

# System aliases
alias cls='clear'              # Clear screen
alias gosel='nvim'             # Quick editor access

# Audio management aliases
alias check-audio='python3 /home/Gos/Downloads/duh/post_reboot_checker.py'
alias fix-audio='python3 /home/Gos/Downloads/duh/volume_fix.py'

# Oh-My-Bash aliases examples (commented)
# alias bashconfig="mate ~/.bashrc"
# alias ohmybash="mate ~/.oh-my-bash"

# ============================================================================
# 5. DEVELOPMENT TOOLS INITIALIZATION
# ============================================================================

# Rust/Cargo environment
. "$HOME/.cargo/env"

# Python environment (pyenv)
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"
eval "$(pyenv virtualenv-init -)"

# Node.js environment (nvm)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Deno environment
. "/home/Gos/.deno/env"

# ASDF version manager
. "$HOME/.asdf/asdf.sh"

# FZF configuration and initialization
eval "$(fzf --bash)"
export FZF_DEFAULT_OPTS='--height 40% --tmux center,50% --layout reverse --border --preview "/home/Gos/.config/fzf/fzf-previewer.sh {}" --preview-window "right:50%:noborder"'

# Zoxide (smart directory navigation)
eval "$(zoxide init bash)"

# Custom completions
source '/home/Gos/.bash_completions/comfy.sh'

# ============================================================================
# 6. TERMINAL & PROMPT CONFIGURATION
# ============================================================================

# Oh-My-Posh prompt configuration
eval "$(oh-my-posh init bash --config '/home/Gos/.oh-my-bash/themes/atomicBit.omp.json')"

# Terminal compatibility fixes
if [[ "$TERM" == "wezterm" ]]; then
    export TERM=xterm-256color
fi

# Cursor editor integration
[[ "$TERM_PROGRAM" == "cursor" ]] && . "$(code --locate-shell-integration-path bash)"

# Load Cursor-specific configuration if available
if [[ "$TERM_PROGRAM" == "cursor" ]] && [[ -f "$HOME/.bashrc.cursor" ]]; then
    source "$HOME/.bashrc.cursor"
fi

# ============================================================================
# 7. STARTUP COMMANDS
# ============================================================================

# Display system information with fastfetch using custom config
fastfetch -c ~/.config/fastfetch/config.jsonc

# direnv
eval "$(direnv hook bash)"
