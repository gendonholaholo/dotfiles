# ============================================================================
# SECTION 1: OH-MY-TMUX FRAMEWORK VARIABLES
# ============================================================================
# This section contains all oh-my-tmux framework configuration variables.
# These control the behavior and appearance of the oh-my-tmux framework.

# -- bindings ------------------------------------------------------------------

# preserve tmux stock bindings,
# while adding bindings that don't conflict with these stock bindings
# /!\ this disables some of Oh my tmux! bindings described in README.md
#   - true
#   - false (default)
tmux_conf_preserve_stock_bindings=false


# -- session creation ----------------------------------------------------------

# prompt for session name when creating a new session, possible values are:
#   - true
#   - false (default)
#   - disabled (do not modify new-session bindings)
tmux_conf_new_session_prompt=false

# new session retains current path, possible values are:
#   - true
#   - false (default)
#   - disabled (do not modify new-session bindings)
tmux_conf_new_session_retain_current_path=false


# -- windows & pane creation ---------------------------------------------------

# new window retains current path, possible values are:
#   - true
#   - false (default)
#   - disabled (do not modify new-window bindings)
tmux_conf_new_window_retain_current_path=false

# new window tries to reconnect ssh sessions, possible values are:
#   - true
#   - false (default)
#   - disabled (do not modify new-window bindings)
tmux_conf_new_window_reconnect_ssh=false

# new pane retains current path, possible values are:
#   - true (default)
#   - false
#   - disabled (do not modify split-window bindings)
tmux_conf_new_pane_retain_current_path=true

# new pane tries to reconnect ssh sessions, possible values are:
#   - true
#   - false (default)
#   - disabled (do not modify split-window bindings)
tmux_conf_new_pane_reconnect_ssh=false


# -- display -------------------------------------------------------------------

# RGB 24-bit colour support, possible values are:
#   - true
#   - false
#   - auto (default)
#
# automatic detection relies on the COLORTERM environment variable being defined
# to 'truecolor' or '24bit' or '$ tput colors' answering '16777216'
# see https://github.com/termstandard/colors
tmux_conf_24b_colour=true


# -- theming -------------------------------------------------------------------

# enable or disable theming:
#   - enabled (default)
#   - disabled
# when disabled, all tmux_conf_theme_xxx variables are ignored except:
#   - tmux_conf_theme_pairing
#   - tmux_conf_theme_prefix
#   - tmux_conf_theme_mouse
#   - tmux_conf_theme_root
#   - tmux_conf_theme_synchronized
tmux_conf_theme=enabled
# tmux_conf_theme=disabled

# -- Default theme colors (less relevant now, but kept for reference) --
# tmux_conf_theme_colour_1="#080808"    # dark gray
tmux_conf_theme_colour_2="#303030"    # gray
tmux_conf_theme_colour_3="#8a8a8a"    # light gray
tmux_conf_theme_colour_4="#00afff"    # light blue
tmux_conf_theme_colour_5="#ffff00"    # yellow
tmux_conf_theme_colour_6="#080808"    # dark gray
tmux_conf_theme_colour_7="#e4e4e4"    # white
tmux_conf_theme_colour_8="#080808"    # dark gray
tmux_conf_theme_colour_9="#ffff00"    # yellow
tmux_conf_theme_colour_10="#ff00af"   # pink
tmux_conf_theme_colour_11="#5fff00"   # green
tmux_conf_theme_colour_12="#8a8a8a"   # light gray
tmux_conf_theme_colour_13="#e4e4e4"   # white
tmux_conf_theme_colour_14="#080808"   # dark gray
tmux_conf_theme_colour_15="#080808"   # dark gray
tmux_conf_theme_colour_16="#d70000"   # red
tmux_conf_theme_colour_17="#e4e4e4"   # white

# -- Window style (less relevant for status bar) --
# tmux_conf_theme_window_fg="white"
tmux_conf_theme_window_fg="#ffffff"
# tmux_conf_theme_window_bg="colour233"
tmux_conf_theme_window_bg="colour233"
# tmux_conf_theme_window_bg="default"

# -- Focused Pane (Make it slightly lighter grey than pure black) --
tmux_conf_theme_highlight_focused_pane=true # Default
tmux_conf_theme_focused_pane_bg="colour16" # Set active pane background color

# -- Pane Borders --
tmux_conf_theme_pane_border_style=thin
tmux_conf_theme_pane_border="colour232" # Same as background color
tmux_conf_theme_pane_active_border="colour232"  # Same as background color

# pane indicator colours (when you hit <prefix> + q)
tmux_conf_theme_pane_indicator="$tmux_conf_theme_colour_4"
tmux_conf_theme_pane_active_indicator="$tmux_conf_theme_colour_4"

# -- Messages --
tmux_conf_theme_message_fg="colour231" # white
tmux_conf_theme_message_bg="colour235" # dark grey
tmux_conf_theme_message_attr="bold"

# -- Mode --
tmux_conf_theme_mode_fg="colour232" # black
tmux_conf_theme_mode_bg="colour226" # yellow
tmux_conf_theme_mode_attr="bold"

# -- Status Bar Core Style --
tmux_conf_theme_status_fg="white" # Pure white text
tmux_conf_theme_status_bg="colour232" # Main background (very dark grey / black)
tmux_conf_theme_status_attr="none"

# -- Terminal Title --
tmux_conf_theme_terminal_title="#h ❐ #S ● #I #W"

# -- Window Status (Inactive) --
# tmux_conf_theme_window_status_fg="colour245" # Light grey text
# tmux_conf_theme_window_status_bg="colour235" # Dark grey background
tmux_conf_theme_window_status_fg="colour245"
tmux_conf_theme_window_status_bg="colour88"
tmux_conf_theme_window_status_attr="none"
tmux_conf_theme_window_status_format=" #I:#W#{?window_flags,#{window_flags},} " # No powerline

# -- Window Status (Current/Active) --
# tmux_conf_theme_window_status_current_fg="colour231"
tmux_conf_theme_window_status_current_fg="white"
tmux_conf_theme_window_status_current_bg="colour25"
tmux_conf_theme_window_status_current_attr="bold"
tmux_conf_theme_window_status_current_format=" #I:#W#{?window_flags,#{window_flags},} " # No powerline

# -- Window Status Activity/Bell/Last (Keep defaults or customize) --
tmux_conf_theme_window_status_activity_fg="default"
tmux_conf_theme_window_status_activity_bg="default"
tmux_conf_theme_window_status_activity_attr="underscore"
tmux_conf_theme_window_status_bell_fg="colour226" # yellow
tmux_conf_theme_window_status_bell_bg="default"
tmux_conf_theme_window_status_bell_attr="blink,bold"
tmux_conf_theme_window_status_last_fg="colour39" # light blue
tmux_conf_theme_window_status_last_bg="colour235"
tmux_conf_theme_window_status_last_attr="none"

# -- Separators (Use simple spaces or pipe) --
tmux_conf_theme_left_separator_main=''
tmux_conf_theme_left_separator_sub='|'
tmux_conf_theme_right_separator_main=''
tmux_conf_theme_right_separator_sub='|'

# -- Status Left --
# Revert to gpakosz default: Session and Uptime
tmux_conf_theme_status_left=" ❐ #S | ↑#{?uptime_y, #{uptime_y}y,}#{?uptime_d, #{uptime_d}d,}#{?uptime_h, #{uptime_h}h,}#{?uptime_m, #{uptime_m}m,} "
# tmux_conf_theme_status_right='#{prefix}#{pairing}#{synchronized} #(curl -m 1 wttr.in?format=3 2>/dev/null; sleep 900) , %R , %d %b | #{username}#{root} | #{hostname} '

# -- Status Right --
# Format: [Load] | [Date] | [Time] | [Batt] | [Prefix/Mouse] | [User@Host]
# Block 1: Load (Orange bg) | Block 2: Date/Time (Grey bg) | Block 3: Battery (Green bg)| Block 5: User/Host (Red bg)
tmux_conf_theme_status_right=" #{prefix}#{mouse}#{pairing}#{synchronized}#{?battery_status,#{battery_status},}#{?battery_bar, #{battery_bar},}#{?battery_percentage, #{battery_percentage},} , %R , %d %b | #{username}#{root} | #{hostname} "


# -- Comment out old style variables --
# tmux_conf_theme_status_left_fg="$tmux_conf_theme_colour_6,$tmux_conf_theme_colour_7,$tmux_conf_theme_colour_8"
# tmux_conf_theme_status_left_bg="$tmux_conf_theme_colour_9,$tmux_conf_theme_colour_10,$tmux_conf_theme_colour_11"
# tmux_conf_theme_status_left_attr="bold,none,none"
# tmux_conf_theme_status_right_fg="$tmux_conf_theme_colour_12,$tmux_conf_theme_colour_13,$tmux_conf_theme_colour_14"
# tmux_conf_theme_status_right_bg="$tmux_conf_theme_colour_15,$tmux_conf_theme_colour_16,$tmux_conf_theme_colour_17"
# tmux_conf_theme_status_right_attr="none,none,bold"

# -- Indicators (Keep defaults or customize) --
tmux_conf_theme_pairing="⚇"
tmux_conf_theme_pairing_fg="none"
tmux_conf_theme_pairing_bg="none"
tmux_conf_theme_pairing_attr="none"

# prefix indicator
tmux_conf_theme_prefix="⌨"                  # U+2328
tmux_conf_theme_prefix_fg="none"
tmux_conf_theme_prefix_bg="none"
tmux_conf_theme_prefix_attr="none"

# mouse indicator
tmux_conf_theme_mouse="↗"                   # U+2197
tmux_conf_theme_mouse_fg="none"
tmux_conf_theme_mouse_bg="none"
tmux_conf_theme_mouse_attr="none"

# root indicator
tmux_conf_theme_root="!"
tmux_conf_theme_root_fg="none"
tmux_conf_theme_root_bg="none"
tmux_conf_theme_root_attr="bold,blink"

# synchronized indicator
tmux_conf_theme_synchronized="⚏"            # U+268F
tmux_conf_theme_synchronized_fg="none"
tmux_conf_theme_synchronized_bg="none"
tmux_conf_theme_synchronized_attr="none"

# -- Battery options --
tmux_conf_battery_bar_symbol_full="◼"
tmux_conf_battery_bar_symbol_empty="◻"
tmux_conf_battery_bar_length="auto"
tmux_conf_battery_bar_palette="gradient" # Default gradient might differ from image
tmux_conf_battery_hbar_palette="heat"
tmux_conf_battery_vbar_palette="gradient"
tmux_conf_battery_status_charging="↑"
tmux_conf_battery_status_discharging="🔋"

# -- Clock --
tmux_conf_theme_clock_colour="colour64" # Example: Greenish
tmux_conf_theme_clock_style="24"


# -- clipboard -----------------------------------------------------------------

# in copy mode, copying selection also copies to the OS clipboard
#   - true
#   - false (default)
#   - disabled
# on Linux, this requires xsel, xclip or wl-copy
tmux_conf_copy_to_os_clipboard=true


# -- urlscan -------------------------------------------------------------------

# options passed to urlscan
tmux_conf_urlscan_options="--compact --dedupe"


# ============================================================================
# SECTION 2: CUSTOM KEY BINDINGS & NAVIGATION
# ============================================================================
# This section contains all custom key bindings and navigation enhancements.

# -- Basic Settings --
# Force interactive shell for all new panes/windows (enables bashrc execution)
set -g default-command "$SHELL -i"
set -g default-shell "$SHELL"

# start with mouse mode enabled
set -g mouse on
bind-key -T copy-mode-vi WheelUpPane send -N2 -X scroll-up
bind-key -T copy-mode-vi WheelDownPane send -N2 -X scroll-down

# prefix + v = enter copy mode (vim-like)
bind v copy-mode

# Vi-style copy mode bindings
bind-key -T copy-mode-vi 'v' if-shell -F '#{selection_present}' 'send -X copy-selection-and-cancel' 'send -X begin-selection'
bind-key -T copy-mode-vi 'y' send -X copy-selection-and-cancel
bind-key -T copy-mode-vi 'Y' send -X select-line \; send -X copy-selection-and-cancel
bind-key -T copy-mode-vi 'r' send -X rectangle-toggle

# Shortcut to copy current pane path: prefix + V (uppercase)
bind V run-shell 'echo "#{pane_current_path}" | tr -d "\n" | wl-copy || echo "#{pane_current_path}" | tr -d "\n" | xclip -selection clipboard; tmux display-message "Path copied: #{pane_current_path}"'

# force Vi mode
#   really you should export VISUAL or EDITOR environment variable, see manual
set -g status-keys vi
set -g mode-keys vi

# replace C-b by C-a instead of using both prefixes
# set -gu prefix2
# unbind C-a
# unbind C-b
# set -g prefix C-a
# bind C-a send-prefix

# if you don't want Oh my tmux! to alter a binding or a setting, use #!important
# bind c new-window -c '#{pane_current_path}' #!important

# move status line to top
#set -g status-position top

# -- Split Panes --
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# -- Navigate Panes (Vim style without wrap-around) --
bind h if -F '#{@pane-is-vim}' 'send-keys h' 'if -F "#{pane_at_left}" "" "select-pane -L"'
bind j if -F '#{@pane-is-vim}' 'send-keys j' 'if -F "#{pane_at_bottom}" "" "select-pane -D"'
bind k if -F '#{@pane-is-vim}' 'send-keys k' 'if -F "#{pane_at_top}" "" "select-pane -U"'
bind l if -F '#{@pane-is-vim}' 'send-keys l' 'if -F "#{pane_at_right}" "" "select-pane -R"'


# ============================================================================
# SECTION 3: PLUGIN MANAGEMENT (TPM)
# ============================================================================
# This section manages tmux plugins via TPM (Tmux Plugin Manager).

# -- tpm -----------------------------------------------------------------------

# while I don't use tpm myself, many people requested official support so here
# is a seamless integration that automatically installs plugins in parallel

# whenever a plugin introduces a variable to be used in 'status-left' or
# 'status-right', you can use it in 'tmux_conf_theme_status_left' and
# 'tmux_conf_theme_status_right' variables.

# by default, launching tmux will update tpm and all plugins
#   - true (default)
#   - false
tmux_conf_update_plugins_on_launch=true

# by default, reloading the configuration will update tpm and all plugins
#   - true (default)
#   - false
tmux_conf_update_plugins_on_reload=true

# by default, reloading the configuration will uninstall tpm and plugins when no
# plugins are enabled
#   - true (default)
#   - false
tmux_conf_uninstall_plugins_on_reload=true

# /!\ the tpm bindings differ slightly from upstream:
#   - installing plugins: <prefix> + I
#   - uninstalling plugins: <prefix> + Alt + u
#   - updating plugins: <prefix> + u

# /!\ do not add set -g @plugin 'tmux-plugins/tpm'
# /!\ do not add run '~/.tmux/plugins/tpm/tpm'

# to enable a plugin, use the 'set -g @plugin' syntax:
# visit https://github.com/tmux-plugins for available plugins
#set -g @plugin 'tmux-plugins/tmux-copycat'
#set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'tmux-plugins/tmux-resurrect'
#set -g @plugin 'tmux-plugins/tmux-continuum'
#set -g @continuum-restore 'on'

# -- tmux-sessionx plugin -----------------------------------------------------
set -g @plugin 'omerxx/tmux-sessionx'

# tmux-sessionx configuration
set -g @sessionx-bind 'o'                    # Use 'o' key (prefix + o)
set -g @sessionx-window-height '85%'         # Window height
set -g @sessionx-window-width '75%'          # Window width
set -g @sessionx-zoxide-mode 'on'            # Enable zoxide integration
set -g @sessionx-custom-paths-subdirectories 'false'
set -g @sessionx-filter-current 'false'      # Show current session
set -g @sessionx-preview-location 'top'    # Preview on right side
set -g @sessionx-preview-ratio '55%'         # Preview width
set -g @sessionx-window-mode 'off'            # Enable window mode
set -g @sessionx-tree-mode 'off'              # Enable tree mode

# Override conflicting tmux-fzf bindings from oh-my-tmux base config
# Note: We'll let tmux-sessionx override these bindings instead of unbinding them




# ============================================================================
# SECTION 4: APPLICATION-SPECIFIC INTEGRATIONS
# ============================================================================
# This section contains integrations with specific applications like Neovim.

# === smart-splits.nvim integration ===
# Smart-splits tmux integration for seamless navigation between Neovim and tmux panes

# Smart pane navigation - works with Neovim smart-splits (with anti-wrap-around)
bind-key -n C-h if -F '#{@pane-is-vim}' 'send-keys C-h' 'if -F "#{pane_at_left}" "" "select-pane -L"'
bind-key -n C-j if -F '#{@pane-is-vim}' 'send-keys C-j' 'if -F "#{pane_at_bottom}" "" "select-pane -D"'  
bind-key -n C-k if -F '#{@pane-is-vim}' 'send-keys C-k' 'if -F "#{pane_at_top}" "" "select-pane -U"'
bind-key -n C-l if -F '#{@pane-is-vim}' 'send-keys C-l' 'if -F "#{pane_at_right}" "" "select-pane -R"'

# copy-mode-vi support (with anti-wrap-around)
bind-key -T copy-mode-vi C-h if -F "#{pane_at_left}" "" "select-pane -L"
bind-key -T copy-mode-vi C-j if -F "#{pane_at_bottom}" "" "select-pane -D"
bind-key -T copy-mode-vi C-k if -F "#{pane_at_top}" "" "select-pane -U"
bind-key -T copy-mode-vi C-l if -F "#{pane_at_right}" "" "select-pane -R"

# Resize panes with Alt + hjkl
bind-key -n M-h if -F '#{@pane-is-vim}' 'send-keys M-h' 'resize-pane -L 3'
bind-key -n M-j if -F '#{@pane-is-vim}' 'send-keys M-j' 'resize-pane -D 3'
bind-key -n M-k if -F '#{@pane-is-vim}' 'send-keys M-k' 'resize-pane -U 3'
bind-key -n M-l if -F '#{@pane-is-vim}' 'send-keys M-l' 'resize-pane -R 3'


# ============================================================================
# SECTION 5: TERMINAL-SPECIFIC CONFIGURATIONS
# ============================================================================
# This section contains terminal-specific fixes and optimizations.

# === WezTerm specific configuration ===
# Force terminal overrides for WezTerm
# set -ga terminal-overrides ",wezterm*:Tc"
