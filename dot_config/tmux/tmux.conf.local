# ============================================================================
# SECTION 6: TERMINAL COLOR INHERITANCE 
# ============================================================================
# Make tmux inherit colors and fonts from terminal

# Enable terminal color inheritance
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*:Tc"
set -ga terminal-overrides ",*:RGB"

# ============================================================================
# GHOSTTY + TMUX IMAGE PROTOCOL FIX
# ============================================================================
# Based on TMUX docs: passthrough sequences need specific format
# Format: \033Ptmux;\033<original_sequence>\033\

# STEP 1: Enable passthrough globally  
set -g allow-passthrough on

# STEP 2: Set correct terminal type for Ghostty in TMUX
set -g default-terminal "tmux-256color"

# STEP 3: Add terminal features for modern terminals 
set -ga terminal-features ',*:RGB:clipboard:ccolour:cstyle:focus:title:sync'

# STEP 4: Critical - Ghostty specific terminal overrides
set -ga terminal-overrides ',ghostty*:Tc:RGB:clipboard:sync:title:focus'
set -ga terminal-overrides ',xterm-ghostty:Tc:RGB:clipboard:sync:title:focus'

# STEP 5: Enable all modern terminal features
set -g focus-events on  
set -g set-clipboard on
set -g mouse on
set -g escape-time 0

# Update environment variables
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

# Make background transparent to match terminal
# set -g status-style 'bg=default,fg=default'
# set -g window-status-style 'bg=default,fg=default'
# set -g window-status-current-style 'bg=default,fg=default'
# set -g window-style 'bg=default,fg=default'
# set -g window-active-style 'bg=default,fg=default'

# Make pane borders use terminal colors
# set -g pane-border-style 'fg=default,bg=default'
# set -g pane-active-border-style 'fg=default,bg=default'

# Make message colors inherit from terminal
# set -g message-style 'bg=default,fg=default'
# set -g message-command-style 'bg=default,fg=default'

# ============================================================================
# SECTION 7: CUSTOM VARIABLES & FUNCTIONS
# ============================================================================
# This section provides templates for custom tmux variables and functions.

# -- custom variables ----------------------------------------------------------

# to define a custom #{foo} variable, define a POSIX shell function between the
# '# EOF' and the '# "$@"' lines. Please note that the opening brace { character
# must be on the same line as the function name otherwise the parse won't detect
# it.
#
# then, use #{foo} in e.g. the 'tmux_conf_theme_status_left' or the
# 'tmux_conf_theme_status_right' variables.

# ------------------------------------------------------------------------------

# # /!\ do not remove the following line
# EOF
#
# # /!\ do not "uncomment" the functions: the leading "# " characters are needed
#
# # usage: #{weather}
# weather() {                                         # see https://github.com/chubin/wttr.in#one-line-output
#   curl -f -s -m 2 'wttr.in?format=3' || printf '\n' # /!\ make sure curl is installed
#   sleep 900                                         # sleep for 15 minutes, throttle network requests whatever the value of status-interval
# }
#
# # usage: #{online}
# online() {
#   ping -c 1 1.1.1.1 >/dev/null 2>&1 && printf '✔' || printf '✘'
# }
#
# # usage: #{wan_ip_v4}
# wan_ip_v4() {
#   curl -f -s -m 2 -4 ifconfig.me
#   sleep 300                                         # sleep for 5 minutes, throttle network requests whatever the value of status-interval
# }
#
# # usage: #{wan_ip_v6}
# wan_ip_v6() {
#   curl -f -s -m 2 -6 ifconfig.me
#   sleep 300                                         # sleep for 5 minutes, throttle network requests whatever the value of status-interval
# }
#
# # usage: #{github_stars}, #{github_stars tmux/tmux}, ...
# github_stars() {
#   repository=${1##*https://github.com/}
#   repository=${repository%% *}
#   repository=${repository%%.git}
#   url="https://api.github.com/repos/${repository:-gpakosz/.tmux}"
#   curl -s "$url" | perl -MJSON::PP=decode_json -CO -0777 -E '$response = decode_json(readline *STDIN); say ($response->{stargazers_count})'
#   sleep 300                                         # sleep for 5 minutes, throttle network requests whatever the value of status-interval
# }

# ============================================================================
# CUSTOM: F11 Yazi Popup Integration with Ghostty Image Preview
# ============================================================================
# Global F11 binding for yazi file manager popup with image support
# Optimized for Ghostty terminal with Kitty graphics protocol

# Basic terminal support (image preview removed for simplicity)
set -ag terminal-overrides ",*:Tc"

# F11 to toggle yazi popup with PERSISTENT SESSION (no image preview)
bind-key -n F11 run-shell '
    # Check if persistent yazi session exists
    if ! tmux has-session -t yazi-persistent 2>/dev/null; then
        # Create persistent background session
        tmux new-session -d -s yazi-persistent -c "#{pane_current_path}" "yazi"
    fi
    
    # Check if popup is currently visible (client attached to yazi-persistent)
    if tmux list-clients -t yazi-persistent 2>/dev/null | grep -q .; then
        # Popup is visible, hide it by detaching all clients
        tmux detach-client -s yazi-persistent -a
    else  
        # Popup is hidden, show it with display-popup
        tmux display-popup -E -h 90% -w 90% -d "#{pane_current_path}" \
            "tmux attach -t yazi-persistent"
    fi
'

# Optional: Cleanup command to kill persistent session when needed
bind-key -n C-F11 run-shell '
    if tmux has-session -t yazi-persistent 2>/dev/null; then
        tmux kill-session -t yazi-persistent
        tmux display-message "Yazi persistent session killed"
    else
        tmux display-message "No yazi persistent session found"  
    fi
'

# ============================================================================
# CUSTOM: F9 YouTube-TUI External Launcher (FIXES IMAGE BLUR!)
# ============================================================================
# Launches youtube-tui in external Ghostty window to bypass TMUX image protocol limitations
# Based on: https://dev.to/ajkerrigan/kitty-image-quality-in-the-terminal-without-giving-up-tmux-16be

# F9 to toggle youtube-tui popup with PERSISTENT SESSION
bind-key -n F9 run-shell '
    # Check if persistent youtube-tui session exists
    if ! tmux has-session -t elmusic-persistent 2>/dev/null; then
        # Create persistent background session
        tmux new-session -d -s elmusic-persistent -c "#{pane_current_path}"
        tmux send-keys -t elmusic-persistent "/home/Gos/.cargo/bin/youtui; tmux kill-session -t elmusic-persistent" Enter
    fi
    
    # Check if popup is currently visible (client attached to elmusic-persistent)
    if tmux list-clients -t elmusic-persistent 2>/dev/null | grep -q .; then
        # Popup is visible, hide it by detaching all clients
        tmux detach-client -s elmusic-persistent -a
    else  
        # Popup is hidden, show it with display-popup
        tmux display-popup -E -h 90% -w 90% -d "#{pane_current_path}" \
            "tmux attach -t elmusic-persistent"
    fi
'

# Ctrl+F9: Alternative - kill any external youtui processes
bind-key -n C-F9 run-shell '
    if tmux has-session -t elmusic-persistent 2>/dev/null; then
        tmux kill-session -t elmusic-persistent
        tmux display-message "ElMusic persistent session killed"
    else
        tmux display-message "No elmusic persistent session found"  
    fi
'



